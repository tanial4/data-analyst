# Copy to .env and fill in your key.  (.env is git-ignored.)

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Optional overrides (defaults shown)
# MODEL=llama-3.3-70b-versatile
# TEMPERATURE=0.0
# MAX_AGENT_ITERATIONS=6
# SERVER_NAME=127.0.0.1
# SERVER_PORT=7860

# --- Sharing & security ---
# Expose a public *.gradio.live tunnel. Anyone with the link can use the app.
# SHARE=false
# Protect the app with a login (STRONGLY recommended whenever SHARE=true).
# Set BOTH to enable the login gate.
# AUTH_USER=admin
# AUTH_PASSWORD=change-me
# Reject uploads larger than this many MB (memory-exhaustion guard).
# MAX_UPLOAD_MB=50
# Show raw error tracebacks in the UI (leave false in production; leaks internals).
# SHOW_ERROR=false
